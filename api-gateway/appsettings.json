{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "super-secret-key-change-in-production-32chars",
    "Issuer": "reward-system",
    "Audience": "reward-system-clients"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "rewards-route": {
        "ClusterId": "reward-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/rewards/{**catch-all}" }
      },
      "rewards-public-route": {
        "ClusterId": "reward-cluster",
        "Match": { "Path": "/api/rewards/criteria" }
      },
      "wallets-route": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/wallets/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": { "Address": "http://auth-service:8080/" }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-service": { "Address": "http://user-service:8080/" }
        }
      },
      "reward-cluster": {
        "Destinations": {
          "reward-service": { "Address": "http://reward-service:8080/" }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": { "Address": "http://wallet-service:8080/" }
        }
      }
    }
  }
}
